# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values:
#
#   cp .env.example .env.local          (macOS / Linux / Git Bash)
#   Copy-Item .env.example .env.local   (Windows PowerShell)
#
# `.env.local` is git-ignored. Never commit real keys.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# --- Supabase (Database + Auth) --------------------------------------------
# Supabase dashboard -> Project Settings -> API
# Use the project URL (bare origin). Do NOT paste the REST endpoint: the client
# appends `/rest/v1` itself, so `...supabase.co/rest/v1/` here would be doubled.
# The URL looks like https://<project-ref>.supabase.co
PI keys
MAILGUN_API_KEY=key-your-mailgun-private-api-key
# Sending domain, e.g. mg.example.com (sandbox: sandbox<id>.mailgun.org)
MAILGUN_DOMAIN=mg.example.comNEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon"/publishable key. Safe for the browser; enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# --- Google OAuth (login with Google, via Supabase Auth) --------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Mailgun (transactional email) ------------------------------------------
# Mailgun dashboard -> Sending -> Domain settings -> A
