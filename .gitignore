# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- dependencies -----------------------------------------------------------
# Note: intentionally unanchored, so nested apps also stay out of git.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- testing ----------------------------------------------------------------
/coverage

# --- next.js ----------------------------------------------------------------
/.next/
/out/
next-env.d.ts

# --- production -------------------------------------------------------------
/build

# --- misc -------------------------------------------------------------------
.DS_Store
Thumbs.db
*.pem
*.tsbuildinfo

# --- debug ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- env files --------------------------------------------------------------
# Real values live in `.env.local`; `.env.example` is committed on purpose.
.env*
!.env.example

# --- supabase / vercel CLI --------------------------------------------------
.vercel
.supabase

# --- legacy-todo-app (the previous Stage project kept in this repo) ---------
data/
*.db
*.db-wal
*.db-shm
web/dist/

# --- editors / OS -----------------------------------------------------------
.vscode/
.idea/
