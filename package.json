{
  "name": "todo-list-webapp",
  "version": "2.0.0",
  "private": true,
  "description": "A to-do list web app: Express + SQLite API with a React + TypeScript UI.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/store.test.js test/api.test.js",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web run test",
    "web:typecheck": "npm --prefix web run typecheck"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "license": "MIT"
}
